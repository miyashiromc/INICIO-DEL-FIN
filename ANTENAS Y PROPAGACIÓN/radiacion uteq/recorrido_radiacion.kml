<?xml version="1.0" encoding="UTF-8"?>
<kml xmlns="http://www.opengis.net/kml/2.2">
<Document>
<name>Visualización de Recorrido y Radiación</name>
<description><![CDATA[Proyecto de medición de radiación.<br><b>Altura y Color</b> de los puntos indican la intensidad de la radiación.]]></description>

<Style id="lineaRecorridoStyle">
  <LineStyle>
    <color>ddffaa00</color>
    <width>3</width>
  </LineStyle>
</Style>

<Style id="puntoRadiacionStyle_1">
  <IconStyle>
    <color>ff830000</color>
    <scale>0.5</scale>
    <Icon><href>http://maps.google.com/mapfiles/kml/shapes/placemark_circle.png</href></Icon>
